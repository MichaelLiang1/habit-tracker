<div id="<%= dom_id habit %>">
  <div>
    <strong>Name:</strong>
    <%= habit.name %>
  </div>
<% todays_completion = habit.completions.find_by(completed_on: Current.user.today) %>
<% if todays_completion %>
  <%= button_to "Undo", habit_completion_path(habit, todays_completion), method: :delete %>
<% else %>
  <%= button_to "Mark done today", habit_completions_path(habit) %>
<% end %>
</div>
